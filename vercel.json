{
  "buildCommand": "cd stellar-game-studio/sgs_frontend && npm install && npm run build",
  "outputDirectory": "stellar-game-studio/sgs_frontend/dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
